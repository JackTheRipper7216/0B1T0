{
  "name": "obito-benchmark",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace @obito/web run dev",
    "build:web": "npm --workspace @obito/web run build",
    "typecheck:web": "npm --workspace @obito/web run typecheck",
    "dev:api": "PYTHONPATH=src:. .venv/bin/python -m uvicorn apps.api.main:app --reload --host 127.0.0.1 --port 8000",
    "test:api": "PYTHONPATH=src:. .venv/bin/python -m pytest -q"
  }
}
