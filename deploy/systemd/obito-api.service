[Unit]
Description=0B1T0 FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obito
WorkingDirectory=/home/obito/0B1T0
Environment=PYTHONPATH=/home/obito/0B1T0/src:/home/obito/0B1T0
Environment=LLMSEC_DB_PATH=/home/obito/0B1T0-data/runs.sqlite3
ExecStart=/home/obito/0B1T0/.venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
